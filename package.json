{
  "name": "glossa",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "pnpm run dev",
    "build": "vite build",
    "build:cf": "BUILD_PRESET=cloudflare-pages vite build",
    "watch": "vite build --watch",
    "preview": "node dist/analog/server/index.mjs",
    "preview:cf": "wrangler pages dev dist/analog/public --compatibility-date=2026-08-25",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.7.0",
    "@analogjs/router": "^2.7.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@forge-cms/auth": "0.0.1",
    "@forge-cms/cloudflare": "0.0.1",
    "@forge-cms/core": "0.0.1",
    "@forge-cms/db": "0.0.1",
    "@forge-cms/runtime": "0.0.1",
    "@forge-cms/storage": "0.0.1",
    "@tailwindcss/vite": "^4.1.4",
    "angular-movement": "^0.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "front-matter": "^4.0.2",
    "h3": "^1.13.0",
    "lumen-icons": "^0.2.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "postcss": "^8.5.3",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.4",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.0",
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular/build": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/angular": "^19.4.2",
    "@types/node": "^24.10.1",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.39.2",
    "ng-primitives": "^0.130.1",
    "@floating-ui/dom": "^1.7.4",
    "jsdom": "^22.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
