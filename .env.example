NODE_ENV=development
AUTH_SECRET=change-me-to-a-long-random-secret
BOOTSTRAP_ADMIN_KEY=change-me-for-first-admin-bootstrap

# DevAuth SSO (primary interactive login). See README.md for setup and
# docs/ARCHITECTURE.md for the protocol details. DEV_AUTH_CLIENT_SECRET must never be
# committed or exposed to the browser.
DEV_AUTH_ISSUER=http://localhost:8787
DEV_AUTH_CLIENT_ID=glossa-dev
DEV_AUTH_CLIENT_SECRET=change-me-to-the-registered-client-secret
DEV_AUTH_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback
